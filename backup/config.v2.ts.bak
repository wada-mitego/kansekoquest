// バランス調整用の定数とボス定義。数値だけを変えて調整できる。
import type { Stats } from './data';

export const BALANCE = {
  /** この問数を回答するごとに次のボスが解放される */
  questionsPerBoss: 20,
  hpBase: 60,
  hpPerDef: 6,
  mpBase: 10,
  mpPerMag: 2,
  costBengari: 6,
  costSuijuku: 8,
  bengariPerMag: 2.5,
  bengariBase: 10,
  suijukuPerMag: 2.5,
  suijukuBase: 20,
  playerAtkPower: 2.2,
  playerBaseHit: 0.92,
  speedHitStep: 0.01,
  hitMin: 0.35,
  hitMax: 0.98,
  critRate: 0.06,
  critMult: 1.6,
  focusMult: 1.5,
  focusMpRatio: 0.3,
  defendMult: 0.5,
  defFactor: 1.2,
  mdefFactor: 1.2,
  jitter: 0.1,
};

export const maxHp = (s: Stats) => BALANCE.hpBase + s.def * BALANCE.hpPerDef;
export const maxMp = (s: Stats) => BALANCE.mpBase + s.mag * BALANCE.mpPerMag;

export interface Move {
  name: string;
  kind: 'phys' | 'magic';
  /** 物理: atk×power − 防御×係数。魔法: mag×power − 魔法防御×係数 */
  power: number;
  /** 物理の基本命中率（魔法は必中） */
  acc: number;
  weight: number;
}

export interface Form {
  label: string;
  /** ボスHPがこの割合以下になると移行 */
  hpBelow: number;
  moves: Move[];
}

export interface BossDef {
  id: string;
  order: number;
  name: string;
  sprite: string;
  hp: number;
  atk: number;
  def: number;
  mag: number;
  mdef: number;
  spd: number;
  /** プレイヤーの物理攻撃の命中率を下げる */
  evasion: number;
  /** ベンガリ(炎)の倍率 */
  fireMult: number;
  tagline: string;
  traits: string[];
  hint: string;
  intro: string;
  moves: Move[];
  forms?: Form[];
}

